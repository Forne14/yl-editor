{
  "name": "@yl/editor",
  "version": "0.4.1",
  "description": "In-place editing core: a draft/publish ContentStore seam, schema registry, path ops and editable() addressing. Store-agnostic; apps bring their own store.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Forne14/yl-editor.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "src",
    "migrations",
    "!src/**/*.test.ts",
    "!src/test-support.ts",
    "!src/access/test-fixture.ts"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite-store.d.ts",
      "import": "./dist/sqlite-store.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js"
    },
    "./access": {
      "types": "./dist/access/index.d.ts",
      "import": "./dist/access/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.js"
    },
    "./chrome": {
      "types": "./dist/chrome/index.d.ts",
      "import": "./dist/chrome/index.js"
    },
    "./chrome/chrome.css": "./dist/chrome/chrome.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "release": "node scripts/release.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "verify": "npm run lint && npm run check && npm test"
  },
  "peerDependencies": {
    "better-sqlite3": ">=13",
    "vitest": ">=4",
    "zod": "^4"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "better-sqlite3": "^13.0.3",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.4",
    "zod": "^4.6.7"
  }
}
